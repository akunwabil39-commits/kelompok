// Prisma Schema for PostgreSQL
// Generator and Datasource Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id          Int      @id @default(autoincrement())
  nim         String   @unique
  password    String
  nama        String
  golongan    String   // Pilihan: 'A' | 'B' | 'C' | 'D'
  gender      String   // 'L' atau 'P'
  role        String   @default("PARTICIPANT") // "ADMIN" | "PARTICIPANT"
  status      String   @default("PENDING")     // "PENDING" | "APPROVED"
  groupNumber Int?     @map("group_number")
  isLeader    Boolean  @default(false) @map("is_leader")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Setting {
  id          Int     @id @default(1)
  totalGroups Int     @default(4) @map("total_groups")
  maxPerGroup Int     @default(10) @map("max_per_group")
  isPublished Boolean @default(false) @map("is_published")

  @@map("settings")
}
